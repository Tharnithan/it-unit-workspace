# Copy to backend/.env or run npm run db:setup --workspace backend.
# backend/.env is loaded automatically; shell environment variables take precedence.
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=https://your-frontend.pages.dev
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=it_unit_workspace
MYSQL_USER=it_unit_app
MYSQL_PASSWORD=replace-with-your-database-password
# Only used when creating a fresh database.
INITIAL_PASSWORD=replace-with-a-unique-strong-password
# Generate with npm run push:keys --workspace backend
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-verified-institute-email@example.org
